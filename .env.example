# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
DATABASE_URL=sqlite:///./data/bds39_pricing.db

# MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_EXPERIMENT_NAME=bds39_counterfactual_pricing

# API & Dashboard
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
BACKEND_API_URL=http://localhost:8000

# Optimization & Guardrails
DEFAULT_GUARDRAIL_CONFIG=configs/guardrails.yaml
